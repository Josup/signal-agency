{
  "version": 2,
  "framework": null,
  "buildCommand": "echo done",
  "outputDirectory": ".",
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "signalai.agency"
        }
      ],
      "destination": "https://www.signalai.agency/:path*",
      "permanent": true
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "headers": {
        "Strict-Transport-Security": "max-age=63072000; includeSubDomains; preload",
        "X-Content-Type-Options": "nosniff",
        "Referrer-Policy": "strict-origin-when-cross-origin",
        "X-Frame-Options": "SAMEORIGIN",
        "Permissions-Policy": "camera=(), microphone=(), geolocation=()",
        "Cache-Control": "public, max-age=0, s-maxage=86400, stale-while-revalidate"
      },
      "continue": true
    },
    {
      "src": "/assets/(.*)\\.(jpg|png|svg|webp)",
      "headers": {
        "Cache-Control": "public, max-age=2592000, s-maxage=2592000, stale-while-revalidate"
      },
      "continue": true
    },
    {
      "src": "/(og-image\\.jpg|favicon\\.svg)",
      "headers": {
        "Cache-Control": "public, max-age=2592000, s-maxage=2592000, stale-while-revalidate"
      },
      "continue": true
    },
    {
      "src": "/journal",
      "dest": "/journal.html"
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "/.*",
      "dest": "/404.html",
      "status": 404
    }
  ]
}
